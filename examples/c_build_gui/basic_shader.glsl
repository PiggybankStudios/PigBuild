
@vs vs
// +--------------------------------------------------------------+
// |                            Vertex                            |
// +--------------------------------------------------------------+
in vec4 position;
in vec4 color0;
out vec4 color;

void main()
{
	gl_Position = position;
	color = color0;
}
@end



@fs fs
// +--------------------------------------------------------------+
// |                           Fragment                           |
// +--------------------------------------------------------------+
in vec4 color;
out vec4 frag_color;

void main()
{
	frag_color = color;
}
@end


// +--------------------------------------------------------------+
// |                           Program                            |
// +--------------------------------------------------------------+
@program basic_shader vs fs